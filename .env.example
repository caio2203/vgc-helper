# Copy to `.env` in the repository root and fill in. Never commit `.env`.
# On Vercel, set these in Project Settings → Environment Variables instead.

# --- App -------------------------------------------------------------------
# Address you open in the browser. In development this is the Vite server.
APP_ORIGIN=http://localhost:5173
# Port of the API (local only; Vite proxies /api to it).
PORT=3000

# --- Sessions --------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# How long a login lasts, in days.
SESSION_TTL_DAYS=30

# --- Login: pick ONE mode ---------------------------------------------------
# github          → Sign in with GitHub, only for the accounts listed below.
# local-password  → One admin password, good for running on your own PC.
AUTH_MODE=local-password

# local-password: generate the hash with `pnpm hash-password` (it never stores the password).
ADMIN_PASSWORD_HASH=

# github: create an OAuth app at https://github.com/settings/developers
# Callback URL: <APP_ORIGIN>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user ids, comma-separated (not usernames). Find yours with:
#   curl -s https://api.github.com/users/<your-username> | grep '"id"'
AUTH_ALLOWED_GITHUB_IDS=

# --- Database ---------------------------------------------------------------
# Local SQLite file (default). Migrations run on start for local files.
DATABASE_URL=file:local.db
# Turso (production). When set, these win over DATABASE_URL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Vercel -----------------------------------------------------------------
# Secret Vercel Cron sends to /api/internal/keepalive (16+ characters).
CRON_SECRET=

# --- Optional ---------------------------------------------------------------
# Serve the built web app from the API (single process on your PC):
#   pnpm build, then set SERVE_WEB_DIR=../web/dist (relative to apps/api) and
#   APP_ORIGIN=http://localhost:3000, and run pnpm start
SERVE_WEB_DIR=
# Trust X-Forwarded-For (set automatically on Vercel).
TRUST_PROXY=

# --- AI (optional) -----------------------------------------------------------
# Google Gemini key for the on-demand Explain button and chat. Without it the AI features are
# hidden and everything else works. Free tier only: create it in Google AI Studio without
# billing. Never commit it; on Vercel add it with `vercel env add GEMINI_API_KEY` (docs/setup.md).
GEMINI_API_KEY=
# Model id, default gemini-3.8-flash (the newest Flash model with a free tier in Nov 2026).
GEMINI_MODEL=
# Model for when the main one is overloaded, default gemini-3.5-flash-lite (free tier); `none`
# turns it off.
GEMINI_FALLBACK_MODEL=
# AI answers per user per 24 hours, cached answers not counted. Default 50.
AI_DAILY_LIMIT=
