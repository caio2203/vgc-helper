{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@vgc-helper/api#dev": {
      "dependsOn": ["^build", "build"],
      "with": ["dev:tsc"],
      "cache": false,
      "persistent": true
    },
    "dev:tsc": {
      "cache": false,
      "persistent": true
    }
  }
}
