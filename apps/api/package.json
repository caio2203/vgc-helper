{
  "name": "@vgc-helper/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API: authentication, teams, settings and authenticated delivery of the data snapshots.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --watch-preserve-output --env-file-if-exists=../../.env dist/main.js",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/cli/migrate.js",
    "hash-password": "node dist/cli/hash-password.js"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@libsql/client": "^0.18.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.2",
    "@vgc-helper/data": "workspace:*",
    "@vgc-helper/engine": "workspace:*",
    "@vgc-helper/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-oauth2": "^1.8.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
